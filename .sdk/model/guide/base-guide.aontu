# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 4
  metrics: count: path: 5
  metrics: count: method: 5

  entity: driving_license: {
    path: "/prawo-jazdy": {
      op: list: method: *GET
    }
  }

  entity: permission: {
    path: "/uprawnienia": {
      op: list: method: *GET
    }
  }

  entity: statistic: {
    path: "/statystyki/pojazdy": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/statystyki/prawo-jazdy": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

  entity: vehicle: {
    path: "/pojazdy": {
      op: list: method: *GET
    }
  }

}